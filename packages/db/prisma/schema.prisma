generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"] // rhel = Vercel runtime
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum MessageRole {
  user
  assistant
  system
  tool
}

enum MessageStatus {
  streaming
  success
  failed
  cancelled
}

enum RunStatus {
  queued
  running
  waiting
  completed
  failed
  cancelled
}

enum ToolStatus {
  pending
  dispatching
  running
  completed
  failed
  cancelled
}

enum WaitpointKind {
  options
  plan
  credit
  media
}

enum WaitpointStatus {
  pending
  answered
  expired
  cancelled
}

model User {
  id           String         @id @default(cuid())
  clerkId      String         @unique
  balanceMicro BigInt         @default(0) // cache of SUM(ledger), changed only in the same tx as a ledger row
  createdAt    DateTime       @default(now())
  chats        Chat[]
  runs         AgentRun[]
  ledger       CreditLedger[]
  attachments  Attachment[]
}

model Chat {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String     @default("New chat")
  pinned    Boolean    @default(false)
  imageSeq  Int        @default(0) // last image name handed out in this chat (img_1, img_2, …)
  deletedAt DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  messages  Message[]
  runs      AgentRun[]

  @@index([userId, updatedAt(sort: Desc), id(sort: Desc)])
  @@index([userId, pinned, updatedAt(sort: Desc), id(sort: Desc)])
}

model Message {
  id              String        @id @default(cuid())
  chatId          String
  chat            Chat          @relation(fields: [chatId], references: [id], onDelete: Cascade)
  role            MessageRole
  status          MessageStatus @default(success)
  content         Json // ContentBlock[], validated by Zod on write and read
  clientMessageId String?
  runId           String?       @unique
  run             AgentRun?     @relation("RunAssistantMessage", fields: [runId], references: [id], onDelete: SetNull)
  checkpointStep  Int           @default(-1) // last LLM step persisted; live stream parts render only after it
  errorCode       String?
  errorMessage    String?
  errorRetryable  Boolean?
  createdAt       DateTime      @default(now())
  attachments     Attachment[]

  @@unique([chatId, clientMessageId])
  @@index([chatId, createdAt(sort: Desc), id(sort: Desc)])
}

model AgentRun {
  id               String           @id @default(cuid())
  chatId           String
  chat             Chat             @relation(fields: [chatId], references: [id], onDelete: Cascade)
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userMessageId    String // a retry runs again for the same user message
  retryOfRunId     String?          @unique // a run can be retried once; a second request returns the same retry
  status           RunStatus        @default(queued)
  triggerRunId     String?          @unique
  steps            Int              @default(0)
  routedModels     String[]
  promptTokens     Int              @default(0)
  completionTokens Int              @default(0)
  errorCode        String?
  errorMessage     String?
  errorRetryable   Boolean?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  finishedAt       DateTime?
  planMode         Boolean          @default(false) // paid tools stay blocked until a plan is approved
  assistantMessage Message?         @relation("RunAssistantMessage")
  tools            ToolInvocation[]
  ledger           CreditLedger[]
  skills           RunSkill[]
  waitpoints       Waitpoint[]

  @@index([chatId, createdAt])
  @@index([userId, createdAt])
  @@index([userMessageId])
}

model ToolInvocation {
  id             String         @id @default(cuid())
  runId          String
  run            AgentRun       @relation(fields: [runId], references: [id], onDelete: Cascade)
  toolCallId     String
  seq            Int
  name           String
  status         ToolStatus     @default(pending)
  input          Json // sanitized, Zod-validated
  output         Json?
  magicaRunId    String?        @unique
  estimateMicro  BigInt         @default(0)
  creditsMicro   BigInt         @default(0)
  startedAt      DateTime?
  finishedAt     DateTime?
  durationMs     Int?
  errorCode      String?
  errorMessage   String?
  errorRetryable Boolean?
  createdAt      DateTime       @default(now())
  ledger         CreditLedger[]

  @@unique([runId, toolCallId])
}

model CreditLedger {
  id               String          @id @default(cuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  deltaMicro       BigInt
  reason           String // grant | tool_charge | refund
  idempotencyKey   String          @unique // grant:<userId> | tool:<toolInvocationId>
  runId            String?
  run              AgentRun?       @relation(fields: [runId], references: [id], onDelete: SetNull)
  toolInvocationId String?
  toolInvocation   ToolInvocation? @relation(fields: [toolInvocationId], references: [id], onDelete: SetNull)
  createdAt        DateTime        @default(now())

  @@index([userId, createdAt])
  @@index([runId])
  @@index([toolInvocationId])
}

// One uploaded file. Created when its Transloadit Assembly completes; linked to a message when sent.
model Attachment {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messageId         String?
  message           Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  assemblyId        String
  transloaditFileId String
  kind              String // image | video | audio
  name              String
  mime              String
  sizeBytes         BigInt
  width             Int?
  height            Int?
  durationSec       Float? // video/audio length from Transloadit; prices duration-billed tools
  url               String
  persistent        Boolean // true = our R2 bucket; false = Transloadit temporary result
  createdAt         DateTime @default(now())

  @@unique([assemblyId, transloaditFileId])
  @@index([userId, createdAt])
  @@index([messageId])
  @@index([createdAt])
}

// A skill loaded during a run. The content snapshot makes a retried or resumed run use the same guidance.
model RunSkill {
  id          String   @id @default(cuid())
  runId       String
  run         AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  name        String
  contentHash String
  content     String
  createdAt   DateTime @default(now())

  @@unique([runId, name])
}

// A question the agent is waiting on (options, plan, credit or media approval). Postgres is the truth; the Trigger.dev token only wakes the run.
model Waitpoint {
  id         String          @id @default(cuid())
  runId      String
  run        AgentRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  key        String // the tool call id, or credit:<step>
  kind       WaitpointKind
  request    Json // Zod-validated WaitpointRequest
  status     WaitpointStatus @default(pending)
  answer     Json?
  tokenId    String?         @unique
  expiresAt  DateTime
  answeredAt DateTime?
  createdAt  DateTime        @default(now())

  @@unique([runId, key])
  @@index([runId, status])
}

// One row per provider per day; the spend cap is a single-row conditional update.
model ProviderSpendDaily {
  provider   String
  day        DateTime @db.Date
  spentMicro BigInt   @default(0)

  @@id([provider, day])
}
