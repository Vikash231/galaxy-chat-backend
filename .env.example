# ---------- shared (api + worker) ----------
DATABASE_URL=postgresql://galaxy:galaxy@localhost:5433/galaxy     # Neon: pooled URL with ?pgbouncer=true&connection_limit=1
NEW_USER_GRANT_MICRO=5000000                                      # app credits given at signup (microcredits)
MIN_ADMISSION_MICRO=5000                                          # minimum balance to send a message
LOG_LEVEL=info

# ---------- migrator ----------
DIRECT_URL=postgresql://galaxy:galaxy@localhost:5433/galaxy       # Neon: direct (non-pooled) URL

# ---------- api ----------
CLERK_JWKS_URL=                # Clerk dashboard → API keys → JWKS URL (https://<instance>.clerk.accounts.dev/.well-known/jwks.json)
CLERK_JWT_KEY=                 # dev only: written by `node scripts/dev-token.mjs --init-env`; rejected when NODE_ENV=production
CLERK_SECRET_KEY=              # sk_test_… (frontend server side)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=  # pk_test_… (frontend)
FRONTEND_ORIGIN=http://localhost:3001
TRIGGER_SECRET_KEY=            # Trigger.dev → project → API keys (tr_dev_… / tr_prod_…)
SEND_RATE_PER_MIN=10
TRANSLOADIT_AUTH_KEY=          # Transloadit → Credentials → "SDK & Uppy" key
TRANSLOADIT_AUTH_SECRET=       # its secret (backend only)
TRANSLOADIT_R2_CREDENTIALS=    # name of the R2 Template Credentials in the Transloadit console; unset = temporary URLs
R2_PUBLIC_URL=                 # https://pub-xxxx.r2.dev or a custom domain on the bucket
UPLOAD_MONTHLY_QUOTA_BYTES=5368709120

# ---------- worker ----------
TRIGGER_PROJECT_REF=           # proj_…
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free   # anything else fails at boot
MAGICA_API_KEY=                # gx_… — worker only, never api/web
MAGICA_BASE_URL=https://inference.magica.com
MAGICA_MODE=fixture            # fixture = no provider calls, 0 credits; live = real Magica
MAGICA_DAILY_CAP_MICRO=200000  # hard daily cap on live Magica spend
AGENT_MAX_STEPS=8
AGENT_HISTORY_LIMIT=40
AGENT_QUEUE_CONCURRENCY=50
TOOL_QUEUE_CONCURRENCY=10
